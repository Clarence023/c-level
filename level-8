#include <stdio.h>
int disp_LCM2(int a, int b);
int main() {
    int x, y;
    scanf("%d %d", &x, &y);
    int result = disp_LCM2(x, y);
    printf("%d\n", result);
}
int disp_LCM2(int a, int b) {
    int max = (a > b) ? a : b;
    while(1) {
        if(max % a == 0 && max % b == 0) {
            return max;
        }
        max++;
    }
}


