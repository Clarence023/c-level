    printf("%d\n", result);
}
int disp_count_sum14(void) {
    int count = 0;
    for(int n = 1; n < 100000; n++) {
        int temp = n, sum = 0;
        while(temp != 0) {
            sum += temp % 10;
            temp /= 10;
        }
        if(sum == 14) {
            count++;
        }
    }
    return count;
}


