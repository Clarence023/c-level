int disp_reverse_number(int n);
int main() {
    int num;
    scanf("%d", &num);
    int result = disp_reverse_number(num);
    printf("%d\n", result);
}
int disp_reverse_number(int n) {
    int rev = 0;
    while(n != 0) {
        rev = rev * 10 + (n % 10);
        n = n / 10;
    }
    return rev;
}


