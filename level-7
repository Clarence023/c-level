program 27:
#include <stdio.h>
void disp_LCM2(int a, int b);
int main() {
    int x, y;
    scanf("%d %d", &x, &y);
    disp_LCM2(x, y);
}
void disp_LCM2(int a, int b) {
    int max = (a > b) ? a : b;
    while(1) {
        if(max % a == 0 && max % b == 0) {
            printf("%d\n", max);
            break;
        }
        max++;
    }
}

