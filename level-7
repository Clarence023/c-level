program 30:
#include <stdio.h>
void disp_count_HCF2(int a, int b);
int main() {
    int x, y;
    scanf("%d %d", &x, &y);
    disp_count_HCF2(x, y);
}
void disp_count_HCF2(int a, int b) {
    int hcf, i;
    for(i = (a < b ? a : b); i >= 1; i--) {
        if(a % i == 0 && b % i == 0) {
            hcf = i;
            break;
        }
    }
    printf("%d\n", hcf);
}

