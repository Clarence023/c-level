program 16:
#include <stdio.h>
void check_prime(int n);
int main() {
    int num;
    scanf("%d", &num);
    check_prime(num);
}
void check_prime(int n) {
    int i, flag = 0;
    if(n <= 1) {
        printf("Not Prime\n");
         
    }
    for(i = 2; i <= n / 2; i++) {
        if(n % i == 0) {
            flag = 1;
            break;
        }
    }
    if(flag == 0) {
        printf("Prime\n");
    } else {
        printf("Not Prime\n");
    }
}


program 17:
