program 14:
#include <stdio.h>
void disp_interchange_first_last_digit(int n);
int main() {
    int num;
    scanf("%d", &num);
    disp_interchange_first_last_digit(num);
}
void disp_interchange_first_last_digit(int n) {
    int first, last, temp, digits = 0, pow10 = 1;
    temp = n;
    last = temp % 10;
    while(temp >= 10) {
        temp /= 10;
        digits++;
        pow10 *= 10;
    }
    first = temp;
    if(digits == 0) {
        printf("%d\n", n);
         
    }
    n = n - first * pow10 - last;
    n = n + last * pow10 + first;
    printf("%d\n", n);
}


